{
  "schema_version": 1,
  "repository": {
    "name": "open-agent-config",
    "upstream": "RealZST/HarnessKit",
    "fork": "SimileciWH/open-agent-config",
    "license": "Apache-2.0",
    "baseline_commit": "4321a802c021736592ba408b5ff913cff3919053",
    "source_of_truth": "source code and tests"
  },
  "inventory": {
    "source_files": 339,
    "rust_files": 89,
    "typescript_and_tsx_files": 158,
    "workflow_files": 4,
    "frontend_root": "src",
    "rust_workspace_root": "crates"
  },
  "workspace": {
    "crates/hk-core": {
      "role": "shared scanning, models, SQLite store, adapters, deployment and services",
      "entry": "crates/hk-core/src/lib.rs"
    },
    "crates/hk-cli": {
      "role": "hk command line interface and embedded web server launcher",
      "entry": "crates/hk-cli/src/main.rs"
    },
    "crates/hk-web": {
      "role": "Axum HTTP API and embedded frontend serving",
      "entry": "crates/hk-web/src/lib.rs"
    },
    "crates/hk-desktop": {
      "role": "Tauri desktop shell and IPC commands",
      "entry": "crates/hk-desktop/src/main.rs"
    },
    "src": {
      "role": "React 19 + Vite frontend shared by Web and Tauri",
      "entry": "src/main.tsx"
    }
  },
  "runtime_entrypoints": [
    {
      "id": "cli-web",
      "path": "crates/hk-cli/src/main.rs::main",
      "flow": "CLI parses commands; serve starts hk-web; other commands open Store, scan, then dispatch"
    },
    {
      "id": "web",
      "path": "crates/hk-web/src/lib.rs::serve",
      "flow": "open ~/.harnesskit/metadata.db; build WebState with adapters; serve Axum router"
    },
    {
      "id": "desktop",
      "path": "crates/hk-desktop/src/main.rs::main",
      "flow": "open Store; build AppState with adapters; register Tauri commands"
    },
    {
      "id": "frontend",
      "path": "src/lib/transport.ts::transport",
      "flow": "Tauri IPC in desktop mode or POST /api/{command} in browser mode"
    }
  ],
  "primary_flow": [
    "adapter::all_adapters",
    "scanner::scan_all",
    "store::Store::sync_extensions",
    "frontend extension grouping",
    "frontend api.toggleExtension",
    "web or desktop toggle command",
    "manager::toggle_extension_with_adapters",
    "deployer or native adapter writer",
    "rescan and store reconciliation"
  ],
