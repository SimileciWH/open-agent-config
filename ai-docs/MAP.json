    "source_of_truth": "source code and tests"
  },
  "inventory": {
    "source_files": 347,
    "rust_files": 90,
    "typescript_and_tsx_files": 162,
    "workflow_files": 4,
    "frontend_root": "src",
    "rust_workspace_root": "crates"
  },
  "workspace": {
    "crates/oac-core": {
      "role": "shared scanning, models, SQLite store, adapters, deployment and services",
      "entry": "crates/oac-core/src/lib.rs"
    },
    "crates/oac-cli": {
      "role": "oac command line interface and embedded web server launcher",
      "entry": "crates/oac-cli/src/main.rs"
    },
    "crates/oac-web": {
      "role": "Axum HTTP API and embedded frontend serving",
      "entry": "crates/oac-web/src/lib.rs"
    },
    "crates/oac-desktop": {
      "role": "Tauri desktop shell and IPC commands",
      "entry": "crates/oac-desktop/src/main.rs"
    },
    "src": {
      "role": "React 19 + Vite frontend shared by Web and Tauri",
      "entry": "src/main.tsx"
    }
  },
  "runtime_entrypoints": [
    {
      "id": "cli-web",
      "path": "crates/oac-cli/src/main.rs::main",
      "flow": "CLI parses commands; serve starts oac-web; other commands open Store, scan, then dispatch"
    },
    {
      "id": "web",
      "path": "crates/oac-web/src/lib.rs::serve",
      "flow": "migrate legacy state, open ~/.open-agent-config/metadata.db, build WebState with adapters, and serve the Axum router"
    },
    {
      "id": "desktop",
      "path": "crates/oac-desktop/src/main.rs::main",
      "flow": "open Store; build AppState with adapters; register Tauri commands"
    },
    {
      "id": "frontend",
      "path": "src/lib/transport.ts::transport",
      "flow": "Tauri IPC in desktop mode or POST /api/{command} in browser mode"
    },
    {
      "id": "development",
      "path": "scripts/dev.mjs::startDevelopmentEnvironment",
      "flow": "npm run dev starts the loopback OAC Web API, waits for readiness, then starts Vite; Tauri starts only Vite"
    }
  ],
  "primary_flow": [
    "adapter::all_adapters",
    "scanner::scan_all",
    "store::Store::sync_extensions",
    "frontend extension grouping",
    "frontend api.toggleExtension",
    "web or desktop toggle command",
    "manager::toggle_extension_with_adapters",
    "deployer or native adapter writer",
    "rescan and store reconciliation"
  ],
